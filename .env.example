# Postgres in production; SQLite ("file:./dev.db") works out of the box for local dev
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# "anthropic" | "openai"
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# "mock" (Phase 1, no key needed) | "tavily" | "exa" | "serper" (Phase 2)
RESEARCH_PROVIDER="mock"
TAVILY_API_KEY=""
