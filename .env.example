# Postgres connection string. If you're using Vercel's "Prisma Postgres"
# storage add-on, it injects STORAGE_POSTGRES_URL (pooled, used at runtime --
# see src/lib/db/index.ts) and STORAGE_DATABASE_URL (direct, used for
# migrations -- see drizzle.config.ts) automatically; DATABASE_URL below is
# only a fallback for any other Postgres host (Supabase, self-hosted, etc.)
# that doesn't use Vercel's naming -- set it directly in that case.
DATABASE_URL=""

# Generate with: openssl rand -base64 32. NextAuth v5 looks for AUTH_SECRET
# first; src/auth.config.ts falls back to NEXTAUTH_SECRET if that's unset,
# so either name works, but only one needs a real value.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# "anthropic" | "openai"
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""

# Per-agent model selection (see src/lib/ai/model-config.ts) -- not every
# agent call needs the same quality bar, so they don't all use one model.
# Defaults: STRONG -> claude-sonnet-5 (Offering/ICP/Signal/GTM), FAST ->
# claude-haiku-4-5-20251001 (Contact -- picks a job title, not user-facing
# content). ANTHROPIC_MODEL alone is a blanket override for everything.
ANTHROPIC_MODEL=""
ANTHROPIC_MODEL_STRONG=""
ANTHROPIC_MODEL_FAST=""
OPENAI_API_KEY=""

# "mock" (no key needed, 6 fictional companies) | "tavily" (real web/news
# search -- see src/lib/research/tavily-provider.ts) | "exa" | "serper" (not
# implemented yet). Leave this BLANK rather than "mock" if you're setting
# TAVILY_API_KEY below -- an unset value here auto-infers "tavily" once a
# key is present, so mock only stays the default when neither is set. Only
# set this explicitly to force a specific provider (e.g. "mock" even with a
# real key sitting in .env for local dev).
RESEARCH_PROVIDER=""
TAVILY_API_KEY=""
# How many of the signal taxonomy's signals to actually search for per
# campaign generation -- each is a separate Tavily call.
TAVILY_MAX_SIGNALS_PER_RUN="5"

# SEC EDGAR full-text search (10-K/10-Q/8-K filings) -- free, no API key.
# Additive to RESEARCH_PROVIDER above, not a replacement: it finds what a
# public company has formally disclosed (a capex increase, a new risk
# factor, an 8-K material agreement) rather than news chatter, so both run
# and their evidence gets merged. Most useful when your customers' own ICP
# includes large public enterprises, even if your customers themselves are
# SMBs -- most SMB target accounts are private and won't appear here at
# all, which is fine, since this only adds evidence, never replaces it.
# See src/lib/research/sec-edgar-provider.ts. Leave this BLANK rather than
# "false" if you're setting SEC_EDGAR_USER_AGENT below -- an unset value
# here auto-infers "true" once a User-Agent is present (setting one is
# itself a clear signal of intent to use this). Set explicitly to "false"
# to keep it off even with a User-Agent on file.
SEC_EDGAR_ENABLED=""
# REQUIRED if enabled -- SEC blocks/rate-limits requests without a
# descriptive User-Agent identifying you. Format: "Company Name email".
SEC_EDGAR_USER_AGENT=""
SEC_EDGAR_MAX_SIGNALS_PER_RUN="5"

# Contact enrichment (see src/lib/contacts/) -- Hunter.io's domain search,
# real people (name + title) actually associated with an account's domain.
# Additive to the Contact Agent, not a replacement: when this finds a
# confident, relevant match, the pipeline surfaces a real verified contact
# instead of the Agent's recommended title; when it doesn't (no key set, no
# website on the account, no good match), the existing recommended-title
# fallback runs exactly as before. Has a free tier -- no forced paid plan
# to try this. Leave blank to keep this off entirely.
HUNTER_API_KEY=""
# 0-100, Hunter's own confidence scale for a given contact match. Below
# this, a candidate is real but not confident enough to promote over a
# recommended-title guess for a specific person's name.
HUNTER_MIN_CONFIDENCE="50"

# --- Pipeline limits (see src/lib/agents/orchestrator.ts) ---

# How many discovered companies actually get scored/contacted/pitched per
# campaign, most-corroborated first. Generation is a resumable series of
# short steps now (see src/lib/agents/orchestrator.ts and
# POST /api/campaigns/[id]/step), so this is purely a cost/quality control,
# not a way to dodge a request timeout -- each account still costs 2 LLM
# calls (Contact + GTM), just no longer within one shared time budget.
MAX_ACCOUNTS_PER_CAMPAIGN="10"

# --- Auth (see src/app/signup, src/lib/auth/rate-limit.ts) ---

# Max signups accepted from one IP per hour -- a deterrent against
# mass-creating free orgs to dodge the campaign quota below, not real abuse
# prevention. See docs/launch-checklist.md item 5.
SIGNUP_MAX_PER_IP_PER_HOUR="5"

# --- Billing (see src/lib/billing/ and docs/launch-checklist.md) ---

# Free-tier campaign cap per org per calendar month.
FREE_PLAN_CAMPAIGNS_PER_MONTH="3"

# Leave blank to keep billing dormant -- /api/billing/* routes respond 501
# instead of erroring, and the app works exactly as it does today.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# One Stripe Price ID per paid plan (src/lib/billing/plans.ts), set only
# once that plan actually has a price -- see docs/launch-checklist.md.
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_GROWTH=""

# --- Password reset (see src/lib/auth/password-reset.ts, src/lib/email/) ---
# Max forgot-password requests accepted from one IP per hour -- same
# reasoning as SIGNUP_MAX_PER_IP_PER_HOUR above, against a separate table
# so the two limits can never interact.
PASSWORD_RESET_MAX_PER_IP_PER_HOUR="5"
# Leave blank and the reset flow still works end-to-end, but "sending" a
# reset email just logs it to the server's own logs (ConsoleEmailProvider)
# -- real for local dev/testing, not a working delivery mechanism for an
# actual user. Set this for real users to actually receive reset emails.
RESEND_API_KEY=""
# Must be on a domain you've verified in Resend, or their unverified
# onboarding address ("SignalIQ <onboarding@resend.dev>", the default here)
# which works today but isn't meant as a long-term production sender.
RESEND_FROM_EMAIL=""

# --- Product analytics (see src/lib/analytics/track.ts) ---
# Leave blank to no-op every track() call. When set, events post directly to
# PostHog's HTTP capture API (no SDK dependency) -- this is a PostHog
# *project* API key (starts with "phc_"), not a personal/admin key.
POSTHOG_KEY=""
# "https://us.i.posthog.com" (default) or "https://eu.i.posthog.com" --
# match the region your PostHog project was created in.
POSTHOG_HOST=""
