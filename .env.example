# Postgres in production; SQLite ("file:./dev.db") works out of the box for local dev.
# To go to production: see the switch instructions at the top of
# src/lib/db/schema.postgres.ts, then set this to your Postgres connection
# string (e.g. Vercel's "Prisma Postgres" add-on -- use its *direct*
# connection string, not the Accelerate one).
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# "anthropic" | "openai"
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# Optional -- overrides the default model in src/lib/ai/anthropic-provider.ts.
ANTHROPIC_MODEL=""
OPENAI_API_KEY=""

# "mock" (Phase 1, no key needed) | "tavily" | "exa" | "serper" (Phase 2)
RESEARCH_PROVIDER="mock"
TAVILY_API_KEY=""

# --- Billing (see src/lib/billing/ and docs/launch-checklist.md) ---

# Free-tier campaign cap per org per calendar month.
FREE_PLAN_CAMPAIGNS_PER_MONTH="3"

# Leave blank to keep billing dormant -- /api/billing/* routes respond 501
# instead of erroring, and the app works exactly as it does today.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# One Stripe Price ID per paid plan (src/lib/billing/plans.ts), set only
# once that plan actually has a price -- see docs/launch-checklist.md.
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_GROWTH=""

# --- Product analytics (see src/lib/analytics/track.ts) ---
# Leave blank to no-op every track() call.
POSTHOG_KEY=""
